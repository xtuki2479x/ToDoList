<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/soft_background"
    tools:context=".MainActivity">

    <!-- ========================================= -->
    <!-- CONTENIDO PRINCIPAL                       -->
    <!-- ========================================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/soft_background">

        <!-- BARRA SUPERIOR -->

        <View
            android:id="@+id/topBar"
            android:layout_width="0dp"
            android:layout_height="104dp"
            android:background="@color/soft_green"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageButton
            android:id="@+id/menuButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/abrir_men"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:layout_constraintStart_toStartOf="@id/topBar"
            app:layout_constraintBottom_toBottomOf="@id/topBar"
            app:tint="@color/white" />

        <!-- ========================================= -->
        <!-- CONTENIDO DE INICIO                       -->
        <!-- ========================================= -->

        <TextView
            android:id="@+id/pageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/inicio"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/menuButton"
            app:layout_constraintEnd_toEndOf="@id/topBar"
            app:layout_constraintHorizontal_bias="0.395"
            app:layout_constraintStart_toEndOf="@id/menuButton"
            app:layout_constraintTop_toTopOf="@id/menuButton"
            app:layout_constraintVertical_bias="0.571" />

        <ScrollView
            android:id="@+id/scrollContent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="24dp"
                android:paddingEnd="20dp"
                android:paddingBottom="32dp">

                <!-- SALUDO -->

                <TextView
                    android:id="@+id/greetingText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/buenos_d_as"
                    android:textColor="@color/soft_text"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/moodQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/c_mo_te_sientes_hoy"
                    android:textColor="@color/soft_text_light"
                    android:textSize="16sp" />

                <!-- ================================= -->
                <!-- SELECTOR DE MOOD                  -->
                <!-- ================================= -->

                <LinearLayout
                    android:id="@+id/moodContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- FELIZ -->

                    <LinearLayout
                        android:id="@+id/moodHappyButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:contentDescription="@string/_10_feliz"
                            android:scaleType="centerInside"
                            android:src="@drawable/feliz" />

                        <TextView
                            android:id="@+id/moodHappy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="@string/_10_feliz"
                            android:textColor="@color/soft_green"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <!-- NEUTRAL -->

                    <LinearLayout
                        android:id="@+id/moodNeutralButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:contentDescription="@string/_10_neutral"
                            android:scaleType="centerInside"
                            android:src="@drawable/neutral" />

                        <TextView
                            android:id="@+id/moodNeutral"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="@string/_10_neutral"
                            android:textColor="@color/soft_green"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <!-- CANSADA -->

                    <LinearLayout
                        android:id="@+id/moodTiredButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:contentDescription="@string/_10_cansada"
                            android:scaleType="centerInside"
                            android:src="@drawable/cansada" />

                        <TextView
                            android:id="@+id/moodTired"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="@string/_10_cansada"
                            android:textColor="@color/soft_coral"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <!-- RELAJADA -->

                    <LinearLayout
                        android:id="@+id/moodRelaxedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:contentDescription="@string/_10_relajada"
                            android:scaleType="centerInside"
                            android:src="@drawable/relajada" />

                        <TextView
                            android:id="@+id/moodRelaxed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="@string/_10_relajada"
                            android:textColor="@color/soft_green"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <!-- INSPIRADA -->

                    <LinearLayout
                        android:id="@+id/moodInspiredButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:contentDescription="@string/_10_inspirada"
                            android:scaleType="centerInside"
                            android:src="@drawable/inspirada" />

                        <TextView
                            android:id="@+id/moodInspired"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="@string/_10_inspirada"
                            android:textColor="@color/soft_mustard"
                            android:textSize="15sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- ================================= -->
                <!-- TARJETA DE AGUA                   -->
                <!-- ================================= -->

                <androidx.cardview.widget.CardView
                    android:id="@+id/waterCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    app:cardBackgroundColor="@color/soft_pink"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/tu_bienestar"
                            android:textColor="@color/soft_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/tomaste_suficiente_agua"
                            android:textColor="@color/soft_text"
                            android:textSize="17sp" />

                        <LinearLayout
                            android:id="@+id/waterContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <CheckBox
                                android:id="@+id/water1"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:buttonTint="@color/soft_green" />

                            <CheckBox
                                android:id="@+id/water2"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:buttonTint="@color/soft_green" />

                            <CheckBox
                                android:id="@+id/water3"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:buttonTint="@color/soft_green" />

                            <CheckBox
                                android:id="@+id/water4"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:buttonTint="@color/soft_green" />

                            <CheckBox
                                android:id="@+id/water5"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:buttonTint="@color/soft_green" />

                            <CheckBox
                                android:id="@+id/water6"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:buttonTint="@color/soft_green" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/waterCounter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/_0_de_6_vasos"
                            android:textColor="@color/soft_text_light"
                            android:textSize="13sp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- ================================= -->
                <!-- RECORDATORIO                      -->
                <!-- ================================= -->

                <androidx.cardview.widget.CardView
                    android:id="@+id/reminderCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/para_hoy"
                            android:textColor="@color/soft_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/todayReminder"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/no_olvides_tomarte_un_peque_o_descanso"
                            android:textColor="@color/soft_text_light"
                            android:textSize="16sp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ========================================= -->
    <!-- MENÚ LATERAL                              -->
    <!-- ========================================= -->

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/soft_background"
        app:headerLayout="@layout/drawer_header"
        app:menu="@menu/drawer_menu"
        app:itemIconTint="@null" />

</androidx.drawerlayout.widget.DrawerLayout>