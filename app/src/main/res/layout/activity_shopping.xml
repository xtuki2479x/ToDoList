<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shoppingDrawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/soft_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/soft_background">

        <!-- Barra superior -->

        <View
            android:id="@+id/shoppingTopBar"
            android:layout_width="0dp"
            android:layout_height="104dp"
            android:background="@color/soft_green"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Botón del menú -->

        <ImageButton
            android:id="@+id/menuButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/abrir_men"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="@color/white"
            app:layout_constraintStart_toStartOf="@id/shoppingTopBar"
            app:layout_constraintBottom_toBottomOf="@id/shoppingTopBar" />

        <!-- Título -->

        <!-- Contenido -->

        <TextView
            android:id="@+id/shoppingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lista_de_compras"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/menuButton"
            app:layout_constraintEnd_toEndOf="@id/shoppingTopBar"
            app:layout_constraintHorizontal_bias="0.343"
            app:layout_constraintStart_toEndOf="@id/menuButton"
            app:layout_constraintTop_toTopOf="@id/menuButton"
            app:layout_constraintVertical_bias="0.571" />

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="90dp"
            app:layout_constraintTop_toBottomOf="@id/shoppingTopBar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/shoppingContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/peque_as_compras_todo_en_orden"
                    android:textColor="@color/soft_coral"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Anota lo que necesitas comprar."
                    android:textColor="@color/soft_text_light"
                    android:textSize="14sp" />

                <!-- Campo para agregar -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/shoppingInput"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:background="@drawable/rounded_edittext"
                        android:hint="@string/qu_necesitas"
                        android:inputType="textCapSentences"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="@color/soft_text"
                        android:textColorHint="@color/soft_text_light"
                        android:textSize="15sp" />

                    <androidx.cardview.widget.CardView
                        android:id="@+id/addShoppingButton"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/soft_coral"
                        app:cardCornerRadius="26dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="@string/new_task"
                            android:textColor="@color/white"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <!-- Lista -->

                <LinearLayout
                    android:id="@+id/shoppingItemsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/noShoppingItemsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:gravity="center"
                    android:text="@string/tu_lista_est_vac_a"
                    android:textColor="@color/soft_text_light"
                    android:textSize="16sp" />

            </LinearLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Menú lateral -->

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/shoppingNavigationView"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/soft_background"
        app:headerLayout="@layout/drawer_header"
        app:menu="@menu/drawer_menu"
        app:itemIconTint="@null" />

</androidx.drawerlayout.widget.DrawerLayout>